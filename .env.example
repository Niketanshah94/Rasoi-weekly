APP_NAME=Rasoi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Admin panel (Filament) and Horizon are served on this host only.
ADMIN_DOMAIN=admin.localhost

# Proxies whose X-Forwarded-* headers are trusted: * behind a tunnel or load
# balancer, or a comma-separated list of IPs. Empty trusts none.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rasoi
DB_USERNAME=rasoi
DB_PASSWORD=rasoi

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sign-in (M3) ---
# Temporary email-and-password sign-in, until Google and an email provider are set up.
PASSWORD_LOGIN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Client IDs the mobile apps' native Google sign-in issues tokens for (M3b, M9)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# --- Billing (M7) ---
# Fake provider for local work and tests: fake | razorpay | polar
BILLING_DRIVER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_YEARLY=
# sandbox | production
POLAR_SERVER=sandbox
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_API_KEY=

# --- Messaging (M8) ---
# log-only fake until a provider is chosen
WHATSAPP_DRIVER=log
WHATSAPP_API_KEY=
WHATSAPP_SENDER_NUMBER=
FIREBASE_CREDENTIALS=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Exchange rates (M7) ---
EXCHANGE_RATES_API_KEY=

# --- Monitoring (M10) ---
SENTRY_LARAVEL_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
